# Copy this file to .env.local and fill in your key from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Milestone 3 — Supabase (leave blank to keep using local file storage)
# From supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Milestone 3B — Stripe (test mode). From dashboard.stripe.com (sandbox):
# Developers → API keys → Secret key (starts sk_test_)
STRIPE_SECRET_KEY=
# Product catalogue → your product → price ID (starts price_)
STRIPE_PRICE_ID=

# Milestone 3C — weekly parent email. From resend.com → API Keys
RESEND_API_KEY=
# Optional: verified sender (leave blank to use Resend's test sender)
EMAIL_FROM=
# Any long random string — protects the weekly cron endpoint
CRON_SECRET=

# Inbound email AI triage (hello@ / schools@). From resend.com → Webhooks →
# the "Signing Secret" shown when you add the email.received webhook.
RESEND_WEBHOOK_SECRET=
# Where "needs a human" emails and auto-reply copies get sent. Defaults to
# jayleon820@gmail.com in code if left blank.
OWNER_EMAIL=
